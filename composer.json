{
  "name": "gohany/retry",
  "description": "Interfaces for retrying operations, the rtry: policy string, and retry budget and circuit breaker contracts",
  "keywords": ["retry", "backoff", "jitter", "circuit breaker", "retry budget"],
  "homepage": "https://github.com/Gohany/Retry",
  "license": "MIT",
  "authors": [
    {
      "name": "Greg Riley",
      "homepage": "https://github.com/Gohany"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "phpunit/phpunit": "Needed to run the contract TestCases in Gohany\\Retry\\Testing against your implementation"
  },
  "autoload": {
    "psr-4": {
      "Gohany\\Retry\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gohany\\Retry\\Tests\\": "tests"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
